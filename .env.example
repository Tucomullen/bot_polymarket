# ============================================================
# POLYMARKET TRADING BOT — CONFIGURACIÓN DE ENTORNO
# ============================================================
# COPIA este archivo como .env y rellena tus valores reales.
# NUNCA subas .env a Git ni lo compartas con nadie.

# --- Clave Privada (L1 Authentication) ---
# Tu clave privada de la wallet EOA (sin el prefijo 0x si usas py-clob-client)
# Si usas Magic/Email login: exporta desde https://reveal.magic.link/polymarket
PRIVATE_KEY=

# --- Dirección del Funder (para wallets proxy) ---
# Es tu dirección de perfil de Polymarket, donde depositas USDC.
# Solo necesaria si usas wallet proxy (Magic/Email o Browser Extension).
# Si usas EOA directa, déjalo vacío.
FUNDER_ADDRESS=

# --- Tipo de Firma ---
# 0 = EOA directa (MetaMask, hardware wallet)
# 1 = Magic/Email wallet (proxy)
# 2 = Gnosis Safe
SIGNATURE_TYPE=0

# --- Credenciales L2 (se generan automáticamente la primera vez) ---
# Después de la primera ejecución, el bot las guarda aquí para reutilizarlas.
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASSPHRASE=

# --- Blockchain ---
CHAIN_ID=137
CLOB_HOST=https://clob.polymarket.com

# --- WebSocket Endpoints ---
WS_MARKET_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
WS_USER_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user

# --- Mercado Objetivo (OPCIONAL si usas Discovery automático) ---
# Si dejas estos campos vacíos, el bot usará Discovery para encontrar
# los mejores mercados automáticamente. Si los rellenas, usará estos.
TARGET_TOKEN_ID_YES=
TARGET_TOKEN_ID_NO=
CONDITION_ID=

# --- Discovery automático ---
MAX_ACTIVE_MARKETS=5

# --- Trading Loop (Fase 2) ---
BANKROLL_USD=1000
CYCLE_INTERVAL_MS=500

# --- Re-scan periódico de mercados (Fase 3) ---
# Intervalo en segundos entre re-scans del discovery automático (default: 300 = 5 min)
DISCOVERY_RESCAN_SEC=300

# --- Configuración de Riesgo ---
MAX_BANKROLL_RISK_PCT=0.05
MAX_SPREAD_CENTS=5
KELLY_FRACTION=0.25

# --- Modo Simulación ---
# true = imprime operaciones sin enviarlas | false = opera en vivo
SIMULATION_MODE=true

# --- SSL (proxy corporativo) ---
# true (default) = verificación SSL normal — OBLIGATORIO en VPS/producción
# false = desactiva SSL (solo para proxy corporativo con cert auto-firmado)
# ⚠️  NUNCA usar false en producción: expone claves privadas a ataques MITM
VERIFY_SSL=true
